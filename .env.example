# Copiá este archivo como .env y completá los valores.

# Google AI Studio → https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
# Se prueban en orden (respaldo ante 429/503)
MODELOS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.8-flash

# Synapse
SYNAPSE_URL=http://localhost:8000/api
# demo: todos los chats de Telegram operan como la paciente ficticia de la demo
# intercambio: cada paciente vincula su cuenta desde el portal (requiere la clave de servicio)
CREDENCIALES_MODO=demo
SYNAPSE_CLAVE_SERVICIO=

# Telegram → @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USUARIO=celta_asistente_fraqqqq_bot
TELEGRAM_SECRETO_WEBHOOK=

# Base propia del asistente (SQLite en desarrollo, PostgreSQL en producción)
DATABASE_URL=sqlite:///./asistente.db
CORS_ORIGENES=http://localhost:5173
