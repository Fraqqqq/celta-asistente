--- /dev/null
+++ b/backend/tests/test_integraciones.py
@@ -0,0 +1,51 @@
+"""Canje de token para el asistente con IA (ADR 0007)."""
+
+import pytest
+
+from app.config import obtener_configuracion
+from tests import test_api
+
+cliente = test_api.cliente  # misma fixture de la API
+
+CLAVE = "clave-de-servicio-de-prueba"
+
+
+@pytest.fixture(autouse=True)
+def clave_configurada(monkeypatch):
+    monkeypatch.setattr(obtener_configuracion(), "clave_servicio_asistente", CLAVE)
+
+
+def canjear(cliente, usuario_id: int, clave: str = CLAVE):
+    return cliente.post(
+        "/api/integraciones/asistente/token",
+        json={"usuario_id": usuario_id},
+        headers={"X-Clave-Servicio": clave},
+    )
+
+
+def test_canje_devuelve_un_token_del_paciente(cliente, esc):
+    r = canjear(cliente, esc.u_ana.id)
+    assert r.status_code == 200
+    token = r.json()["token"]
+    turnos = cliente.get("/api/portal/turnos", headers={"Authorization": f"Bearer {token}"})
+    assert turnos.status_code == 200
+
+
+def test_el_token_canjeado_no_tiene_mas_permisos_que_el_paciente(cliente, esc):
+    token = canjear(cliente, esc.u_ana.id).json()["token"]
+    r = cliente.get("/api/pacientes", headers={"Authorization": f"Bearer {token}"})
+    assert r.status_code == 403
+
+
+@pytest.mark.parametrize("clave", ["", "otra-clave"])
+def test_clave_invalida(cliente, esc, clave):
+    assert canjear(cliente, esc.u_ana.id, clave).status_code == 401
+
+
+def test_solo_para_pacientes(cliente, esc):
+    assert canjear(cliente, esc.u_recepcion.id).status_code == 404
+
+
+def test_desactivado_sin_clave_configurada(cliente, esc, monkeypatch):
+    monkeypatch.setattr(obtener_configuracion(), "clave_servicio_asistente", "")
+    assert canjear(cliente, esc.u_ana.id, "").status_code == 401
