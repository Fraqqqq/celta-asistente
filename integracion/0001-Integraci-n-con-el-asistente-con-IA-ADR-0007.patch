@@ -0,0 +1,336 @@
+import { useQueryClient } from "@tanstack/react-query";
+import clsx from "clsx";
+import { MessageCircle, RotateCcw, Send, SendHorizontal, X } from "lucide-react";
+import { useEffect, useId, useRef, useState, type FormEvent } from "react";
+import { asistente, type AccionPropuesta } from "@/lib/asistente";
+import { Boton, BotonIcono } from "@/ui/boton";
+import { Isotipo } from "./marca";
+
+type EstadoAccion = "pendiente" | "resolviendo" | "confirmada" | "descartada";
+
+interface Burbuja {
+  id: number;
+  rol: "usuario" | "modelo";
+  texto: string;
+  accion?: AccionPropuesta & { estado: EstadoAccion };
+}
+
+const SUGERENCIAS = [
+  "Quiero sacar un turno",
+  "¿Qué turnos tengo?",
+  "Necesito cambiar un turno",
+  "¿Cuánto me sale una consulta?",
+];
+
+let contador = 0;
+const nueva = (b: Omit<Burbuja, "id">): Burbuja => ({ ...b, id: ++contador });
+
+/**
+ * Chat con el asistente de IA, flotante sobre el portal del paciente.
+ * Las reservas, cambios y cancelaciones se proponen con un resumen y solo se ejecutan
+ * si el paciente toca "Confirmar".
+ */
+export function Asistente() {
+  const [abierto, setAbierto] = useState(false);
+  const [burbujas, setBurbujas] = useState<Burbuja[]>([]);
+  const [cargado, setCargado] = useState(false);
+  const [escribiendo, setEscribiendo] = useState(false);
+  const [entrada, setEntrada] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const idTitulo = useId();
+  const idPanel = useId();
+  const refBoton = useRef<HTMLButtonElement>(null);
+  const refEntrada = useRef<HTMLInputElement>(null);
+  const refLista = useRef<HTMLDivElement>(null);
+  const cliente = useQueryClient();
+
+  // Al abrir por primera vez se recupera la conversación guardada.
+  useEffect(() => {
+    if (!abierto || cargado) return;
+    asistente
+      .historial()
+      .then((h) => setBurbujas(h.map((m) => nueva(m))))
+      .catch((e: Error) => setError(e.message))
+      .finally(() => setCargado(true));
+  }, [abierto, cargado]);
+
+  useEffect(() => {
+    if (abierto) refEntrada.current?.focus();
+  }, [abierto]);
+
+  useEffect(() => {
+    refLista.current?.scrollTo({ top: refLista.current.scrollHeight, behavior: "smooth" });
+  }, [burbujas, escribiendo]);
+
+  useEffect(() => {
+    if (!abierto) return;
+    const escape = (e: KeyboardEvent) => {
+      if (e.key !== "Escape") return;
+      setAbierto(false);
+      refBoton.current?.focus();
+    };
+    document.addEventListener("keydown", escape);
+    return () => document.removeEventListener("keydown", escape);
+  }, [abierto]);
+
+  function cerrar() {
+    setAbierto(false);
+    refBoton.current?.focus();
+  }
+
+  async function enviar(texto: string) {
+    const limpio = texto.trim();
+    if (!limpio || escribiendo) return;
+    setEntrada("");
+    setError(null);
+    setBurbujas((b) => [...b, nueva({ rol: "usuario", texto: limpio })]);
+    setEscribiendo(true);
+    try {
+      const r = await asistente.enviar(limpio);
+      setBurbujas((b) => [
+        ...b,
+        nueva({
+          rol: "modelo",
+          texto: r.texto,
+          accion: r.accion ? { ...r.accion, estado: "pendiente" } : undefined,
+        }),
+      ]);
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setEscribiendo(false);
+      refEntrada.current?.focus();
+    }
+  }
+
+  async function resolver(burbuja: Burbuja, confirmar: boolean) {
+    if (!burbuja.accion) return;
+    const marcar = (estado: EstadoAccion) =>
+      setBurbujas((bs) =>
+        bs.map((b) => (b.id === burbuja.id && b.accion ? { ...b, accion: { ...b.accion, estado } } : b)),
+      );
+    marcar("resolviendo");
+    setError(null);
+    try {
+      const r = await asistente.resolver(burbuja.accion.id, confirmar);
+      marcar(confirmar ? "confirmada" : "descartada");
+      setBurbujas((b) => [...b, nueva({ rol: "modelo", texto: r.texto })]);
+      // Los turnos cambiaron: se refrescan las pantallas del portal.
+      if (confirmar) await cliente.invalidateQueries({ queryKey: ["portal"] });
+    } catch (e) {
+      marcar("pendiente");
+      setError((e as Error).message);
+    }
+  }
+
+  async function reiniciar() {
+    await asistente.reiniciar().catch(() => undefined);
+    setBurbujas([]);
+    setError(null);
+    refEntrada.current?.focus();
+  }
+
+  async function vincularTelegram() {
+    try {
+      const { enlace } = await asistente.vincularTelegram();
+      window.open(enlace, "_blank", "noopener,noreferrer");
+    } catch (e) {
+      setError((e as Error).message);
+    }
+  }
+
+  function alEnviar(e: FormEvent) {
+    e.preventDefault();
+    void enviar(entrada);
+  }
+
+  return (
+    <>
+      <button
+        ref={refBoton}
+        type="button"
+        onClick={() => (abierto ? cerrar() : setAbierto(true))}
+        aria-expanded={abierto}
+        aria-controls={idPanel}
+        className={clsx(
+          "fixed right-4 bottom-20 z-40 inline-flex h-12 items-center gap-2 rounded-full pr-5 pl-4 text-sm font-medium shadow-flotante transition-all sm:right-6 sm:bottom-6",
+          "bg-marca-700 text-white hover:bg-marca-800 active:scale-[0.98] dark:bg-marca-400 dark:text-marca-950 dark:hover:bg-marca-300",
+          abierto && "max-sm:hidden",
+        )}
+      >
+        {abierto ? <X className="size-5" aria-hidden /> : <MessageCircle className="size-5" aria-hidden />}
+        {abierto ? "Cerrar asistente" : "Asistente"}
+      </button>
+
+      {abierto && (
+        <section
+          id={idPanel}
+          role="dialog"
+          aria-modal="false"
+          aria-labelledby={idTitulo}
+          className={clsx(
+            "animate-aparecer fixed z-50 flex flex-col overflow-hidden border border-borde bg-superficie text-texto shadow-flotante",
+            "inset-x-0 bottom-0 h-[88dvh] rounded-t-2xl",
+            "sm:inset-x-auto sm:right-6 sm:bottom-22 sm:h-[min(640px,calc(100dvh-8rem))] sm:w-[400px] sm:rounded-2xl",
+          )}
+        >
+          <header className="flex items-center gap-3 border-b border-borde px-4 py-3">
+            <Isotipo className="size-8 shrink-0" />
+            <div className="min-w-0 flex-1">
+              <h2 id={idTitulo} className="text-[15px] font-semibold tracking-tight">
+                Asistente del Celta
+              </h2>
+              <p className="text-[11.5px] text-texto-3">
+                Con IA · puede equivocarse, revisá antes de confirmar
+              </p>
+            </div>
+            <BotonIcono etiqueta="Seguir en Telegram" onClick={vincularTelegram}>
+              <Send className="size-4" aria-hidden />
+            </BotonIcono>
+            <BotonIcono etiqueta="Nueva conversación" onClick={reiniciar}>
+              <RotateCcw className="size-4" aria-hidden />
+            </BotonIcono>
+            <BotonIcono etiqueta="Cerrar" onClick={cerrar}>
+              <X className="size-4" aria-hidden />
+            </BotonIcono>
+          </header>
+
+          <div
+            ref={refLista}
+            role="log"
+            aria-live="polite"
+            aria-label="Conversación con el asistente"
+            className="flex-1 space-y-3 overflow-y-auto px-4 py-4"
+          >
+            {cargado && burbujas.length === 0 && (
+              <div className="space-y-3 pt-2">
+                <p className="text-sm text-texto-2">
+                  ¡Hola! Puedo sacarte un turno, mostrarte los que tenés, cambiarlos o cancelarlos. Escribime
+                  como le escribirías a la recepción.
+                </p>
+                <div className="flex flex-wrap gap-2">
+                  {SUGERENCIAS.map((s) => (
+                    <button
+                      key={s}
+                      type="button"
+                      onClick={() => enviar(s)}
+                      className="rounded-full border border-borde px-3 py-1.5 text-[13px] text-texto-2 transition-colors hover:border-acento hover:text-acento-texto"
+                    >
+                      {s}
+                    </button>
+                  ))}
+                </div>
+              </div>
+            )}
+
+            {burbujas.map((b) => (
+              <div key={b.id} className={clsx("flex", b.rol === "usuario" ? "justify-end" : "justify-start")}>
+                <div className="max-w-[85%] space-y-2">
+                  <p
+                    className={clsx(
+                      "rounded-2xl px-3.5 py-2 text-sm whitespace-pre-line",
+                      b.rol === "usuario"
+                        ? "rounded-br-md bg-marca-700 text-white dark:bg-marca-400 dark:text-marca-950"
+                        : "rounded-bl-md bg-superficie-2 text-texto",
+                    )}
+                  >
+                    <span className="sr-only">{b.rol === "usuario" ? "Vos: " : "Asistente: "}</span>
+                    {b.texto}
+                  </p>
+                  {b.accion && <TarjetaAccion burbuja={b} onResolver={resolver} />}
+                </div>
+              </div>
+            ))}
+
+            {escribiendo && (
+              <div className="flex justify-start" role="status">
+                <span className="sr-only">El asistente está escribiendo…</span>
+                <span className="flex gap-1 rounded-2xl rounded-bl-md bg-superficie-2 px-4 py-3">
+                  {[0, 1, 2].map((i) => (
+                    <span
+                      key={i}
+                      className="size-1.5 animate-pulse rounded-full bg-texto-3"
+                      style={{ animationDelay: `${i * 150}ms` }}
+                    />
+                  ))}
+                </span>
+              </div>
+            )}
+
+            {error && (
+              <p
+                role="alert"
+                className="rounded-xl bg-red-50 px-3 py-2 text-[13px] text-red-700 dark:bg-red-950/50 dark:text-red-300"
+              >
+                {error}
+              </p>
+            )}
+          </div>
+
+          <form onSubmit={alEnviar} className="flex items-center gap-2 border-t border-borde p-3">
+            <label htmlFor={`${idPanel}-entrada`} className="sr-only">
+              Mensaje para el asistente
+            </label>
+            <input
+              id={`${idPanel}-entrada`}
+              ref={refEntrada}
+              value={entrada}
+              onChange={(e) => setEntrada(e.target.value)}
+              maxLength={1000}
+              autoComplete="off"
+              placeholder="Escribí tu consulta…"
+              className="h-10 min-w-0 flex-1 rounded-xl border border-borde bg-superficie px-3.5 text-sm placeholder:text-texto-3 focus:border-acento focus:ring-4 focus:ring-acento/15 focus:outline-none"
+            />
+            <Boton
+              type="submit"
+              aria-label="Enviar"
+              disabled={!entrada.trim() || escribiendo}
+              className="px-3"
+            >
+              <SendHorizontal className="size-4" aria-hidden />
+            </Boton>
+          </form>
+        </section>
+      )}
+    </>
+  );
+}
+
+function TarjetaAccion({
+  burbuja,
+  onResolver,
+}: {
+  burbuja: Burbuja;
+  onResolver: (b: Burbuja, confirmar: boolean) => void;
+}) {
+  const accion = burbuja.accion!;
+  const resuelta = accion.estado === "confirmada" || accion.estado === "descartada";
+  return (
+    <div className="rounded-2xl border border-borde bg-superficie p-3.5 shadow-suave">
+      <p className="text-[13px] leading-relaxed text-texto">{accion.resumen}</p>
+      {resuelta ? (
+        <p className="mt-2 text-[12.5px] font-medium text-texto-3">
+          {accion.estado === "confirmada" ? "✓ Confirmado" : "Descartado"}
+        </p>
+      ) : (
+        <div className="mt-3 flex gap-2">
+          <Boton
+            tamano="sm"
+            cargando={accion.estado === "resolviendo"}
+            onClick={() => onResolver(burbuja, true)}
+          >
+            Confirmar
+          </Boton>
+          <Boton
+            tamano="sm"
+            variante="secundario"
+            disabled={accion.estado === "resolviendo"}
+            onClick={() => onResolver(burbuja, false)}
+          >
+            Descartar
+          </Boton>
+        </div>
+      )}
+    </div>
+  );
+}
