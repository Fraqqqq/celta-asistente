+"""Integraciones con otros sistemas del centro."""
+
+import hmac
+
+from fastapi import APIRouter, Header
+from pydantic import BaseModel
+from sqlalchemy.orm import Session
+
+from app.config import obtener_configuracion
+from app.dependencias import Sesion
+from app.errores import NoAutenticado, NoEncontrado
+from app.esquemas import SesionSalida
+from app.modelos import Usuario
+from app.modelos.enums import Rol
+from app.seguridad import crear_token
+
+router = APIRouter(prefix="/integraciones", tags=["Integraciones"])
+
+
+class IntercambioEntrada(BaseModel):
+    usuario_id: int
+
+
+@router.post(
+    "/asistente/token",
+    response_model=SesionSalida,
+    summary="Token de un paciente para el asistente con IA (ADR 0007)",
+)
+def token_para_asistente(
+    datos: IntercambioEntrada,
+    clave: str = Header(default="", alias="X-Clave-Servicio"),
+    sesion: Session = Sesion,
+):
+    """El asistente canjea su clave de servicio por un token del paciente que vinculó su
+    cuenta de Telegram. El token tiene los mismos permisos que la sesión del portal: el
+    asistente no puede hacer nada que el paciente no pueda hacer."""
+    esperada = obtener_configuracion().clave_servicio_asistente
+    if not esperada or not hmac.compare_digest(clave.encode(), esperada.encode()):
+        raise NoAutenticado("Clave de servicio inválida.")
+    usuario = sesion.get(Usuario, datos.usuario_id)
+    if usuario is None or not usuario.activo or usuario.rol != Rol.PACIENTE:
+        raise NoEncontrado("No hay un paciente activo con ese usuario.")
+    return SesionSalida(token=crear_token(usuario.id, usuario.rol), usuario=usuario)
