@@ -0,0 +1,55 @@
+// Cliente del asistente con IA (proyecto aparte: celta-asistente).
+// El asistente recibe el mismo token del portal y opera Synapse en nombre del paciente.
+
+import { token } from "./api";
+
+const BASE = import.meta.env.VITE_ASISTENTE_URL as string | undefined;
+
+/** El widget solo aparece si el despliegue configura la URL del asistente. */
+export const asistenteDisponible = Boolean(BASE);
+
+export interface AccionPropuesta {
+  id: string;
+  resumen: string;
+}
+
+export interface RespuestaAsistente {
+  texto: string;
+  accion: AccionPropuesta | null;
+}
+
+export interface MensajeAsistente {
+  rol: "usuario" | "modelo";
+  texto: string;
+}
+
+async function pedir<T>(metodo: "GET" | "POST", ruta: string, cuerpo?: unknown): Promise<T> {
+  let respuesta: Response;
+  try {
+    respuesta = await fetch(`${BASE}/api${ruta}`, {
+      method: metodo,
+      headers: {
+        Authorization: `Bearer ${token.leer() ?? ""}`,
+        ...(cuerpo === undefined ? {} : { "Content-Type": "application/json" }),
+      },
+      body: cuerpo === undefined ? undefined : JSON.stringify(cuerpo),
+    });
+  } catch {
+    throw new Error("No pudimos conectar con el asistente. Probá de nuevo en un rato.");
+  }
+  if (respuesta.status === 204) return undefined as T;
+  const datos = await respuesta.json().catch(() => null);
+  if (!respuesta.ok) {
+    throw new Error(datos?.mensaje ?? datos?.detail ?? "El asistente no pudo responder.");
+  }
+  return datos as T;
+}
+
+export const asistente = {
+  historial: () => pedir<MensajeAsistente[]>("GET", "/chat/historial"),
+  enviar: (mensaje: string) => pedir<RespuestaAsistente>("POST", "/chat", { mensaje }),
+  resolver: (id: string, confirmar: boolean) =>
+    pedir<RespuestaAsistente>("POST", `/chat/acciones/${id}`, { confirmar }),
+  reiniciar: () => pedir<void>("POST", "/chat/reiniciar"),
+  vincularTelegram: () => pedir<{ enlace: string; minutos_vigencia: number }>("POST", "/vinculos/telegram"),
+};
